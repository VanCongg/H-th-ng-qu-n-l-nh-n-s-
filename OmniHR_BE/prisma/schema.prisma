generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum CareerLevel {
  INTERN
  FRESHER
  JUNIOR
  MIDDLE
  SENIOR
  LEAD
}

enum ManagerType {
  DIRECT
  PROJECT
}

enum AttendanceRecordType {
  CHECK_IN
  CHECK_OUT
  ADJUSTMENT
}

enum AttendanceShift {
  MORNING
  AFTERNOON
}

enum AttendanceStatus {
  ON_TIME
  LATE
  EARLY_OUT
  MANUAL_ADJUSTMENT
}

enum PayrollPeriodStatus {
  DRAFT
  FINALIZED
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum TaskSkillImportance {
  REQUIRED
  IMPORTANT
  NICE_TO_HAVE
}

enum TeamMemberRole {
  LEAD
  MEMBER
}

enum TaskAssignmentType {
  MANUAL
  AI_SUGGESTED
  REASSIGNED
}

enum AiTaskSuggestionStatus {
  GENERATED
  SELECTED
  EXPIRED
  CANCELLED
}

enum ChatbotMessageRole {
  USER
  ASSISTANT
  TOOL
  SYSTEM
}

enum ChatbotActionType {
  SUBMIT_LEAVE_REQUEST
  CANCEL_LEAVE_REQUEST
  CREATE_ATTENDANCE_CORRECTION_REQUEST
}

enum ChatbotActionStatus {
  PENDING
  CONFIRMED
  EXECUTED
  CANCELLED
  EXPIRED
  FAILED
}

model User {
  id                  Int       @id @default(autoincrement())
  username            String    @unique @db.VarChar(100)
  email               String    @unique @db.VarChar(160)
  passwordHash        String    @map("password_hash")
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  isActive            Boolean   @default(true) @map("is_active")
  refreshTokenHash    String?   @map("refresh_token_hash")
  refreshTokenVersion Int       @default(0) @map("refresh_token_version")
  lastLoginAt         DateTime? @map("last_login_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  employee                   Employee?
  userRoles                  UserRole[]
  auditLogs                  AuditLog[]
  approvedLeaveRequests      LeaveRequest[]         @relation("LeaveApprover")
  createdAttendanceRecords   AttendanceRecord[]     @relation("AttendanceCreatedBy")
  updatedAttendanceRecords   AttendanceRecord[]     @relation("AttendanceUpdatedBy")
  createdProjects            Project[]              @relation("ProjectCreatedBy")
  createdTasks               Task[]                 @relation("TaskCreatedBy")
  assignedTasks              Task[]                 @relation("TaskAssignedBy")
  taskAssignments            TaskAssignment[]       @relation("TaskAssignmentAssignedBy")
  aiTaskSuggestions          AiTaskSuggestion[]     @relation("AiTaskSuggestionRequestedBy")
  chatbotConversations       ChatbotConversation[]
  chatbotPendingActions      ChatbotPendingAction[]
  notifications              Notification[]
  reviewedPerformanceReviews PerformanceReview[]    @relation("PerformanceReviewReviewer")

  @@map("users")
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique @db.VarChar(50)
  description     String?          @db.VarChar(255)
  isSystem        Boolean          @default(false) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  code            String           @unique @db.VarChar(80)
  description     String?          @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     Int      @map("user_id")
  roleId     Int      @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy Int?     @map("assigned_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Policy {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(120)
  description String?  @db.VarChar(255)
  resource    String   @db.VarChar(80)
  action      String   @db.VarChar(80)
  effect      String   @default("ALLOW") @db.VarChar(20)
  condition   Json?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("policies")
}

model Department {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(50)
  name      String    @db.VarChar(160)
  parentId  Int?      @map("parent_id")
  managerId Int?      @map("manager_id")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children  Department[] @relation("DepartmentTree")
  manager   Employee?    @relation("DepartmentManager", fields: [managerId], references: [id])
  employees Employee[]
  positions Position[]
  teams     Team[]
  projects  Project[]
  tasks     Task[]

  @@index([managerId])
  @@map("departments")
}

model Position {
  id           Int       @id @default(autoincrement())
  code         String    @unique @db.VarChar(50)
  name         String    @db.VarChar(160)
  departmentId Int?      @map("department_id")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  department     Department?     @relation(fields: [departmentId], references: [id])
  employees      Employee[]
  positionSkills PositionSkill[]

  @@index([departmentId])
  @@map("positions")
}

model Employee {
  id            Int            @id @default(autoincrement())
  employeeCode  String         @unique @map("employee_code") @db.VarChar(50)
  fullName      String         @map("full_name") @db.VarChar(160)
  companyEmail  String         @unique @map("company_email") @db.VarChar(160)
  avatarUrl     String?        @map("avatar_url") @db.Text
  personalEmail String?        @map("personal_email") @db.VarChar(160)
  phone         String?        @db.VarChar(40)
  birthDate     DateTime       @map("birth_date") @db.Date
  hireDate      DateTime?      @map("hire_date") @db.Date
  status        EmployeeStatus @default(ACTIVE)
  departmentId  Int?           @map("department_id")
  positionId    Int?           @map("position_id")
  careerLevel   CareerLevel    @default(MIDDLE) @map("career_level")
  userId        Int?           @unique @map("user_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  department           Department?            @relation(fields: [departmentId], references: [id])
  position             Position?              @relation(fields: [positionId], references: [id])
  user                 User?                  @relation(fields: [userId], references: [id])
  managedDepartments   Department[]           @relation("DepartmentManager")
  ledTeams             Team[]                 @relation("TeamLead")
  teamMemberships      TeamMember[]
  subordinateRelations EmployeeManager[]      @relation("EmployeeManagerEmployee")
  managerRelations     EmployeeManager[]      @relation("EmployeeManagerManager")
  attendanceRecords    AttendanceRecord[]
  leaveRequests        LeaveRequest[]
  managedProjects      Project[]              @relation("ProjectManager")
  assignedTasks        Task[]                 @relation("TaskAssignee")
  employeeSkills       EmployeeSkill[]
  taskAssignments      TaskAssignment[]       @relation("TaskAssignmentAssignee")
  aiSuggestionItems    AiTaskSuggestionItem[]
  performanceReviews   PerformanceReview[]
  compensation         EmployeeCompensation?
  payslips             Payslip[]

  @@map("employees")
}

model EmployeeManager {
  id          Int         @id @default(autoincrement())
  employeeId  Int         @map("employee_id")
  managerId   Int         @map("manager_id")
  managerType ManagerType @default(DIRECT) @map("manager_type")
  startDate   DateTime    @default(now()) @map("start_date") @db.Date
  endDate     DateTime?   @map("end_date") @db.Date
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  employee Employee @relation("EmployeeManagerEmployee", fields: [employeeId], references: [id])
  manager  Employee @relation("EmployeeManagerManager", fields: [managerId], references: [id])

  @@unique([employeeId, managerId, managerType, startDate])
  @@map("employee_managers")
}

model Team {
  id           Int       @id @default(autoincrement())
  departmentId Int       @map("department_id")
  leadId       Int?      @map("lead_id")
  code         String    @unique @db.VarChar(50)
  name         String    @db.VarChar(160)
  description  String?   @db.Text
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  department Department   @relation(fields: [departmentId], references: [id])
  lead       Employee?    @relation("TeamLead", fields: [leadId], references: [id])
  members    TeamMember[]
  tasks      Task[]

  @@index([departmentId, leadId, isActive])
  @@map("teams")
}

model TeamMember {
  id         Int            @id @default(autoincrement())
  teamId     Int            @map("team_id")
  employeeId Int            @map("employee_id")
  role       TeamMemberRole @default(MEMBER) @map("role_in_team")
  joinedAt   DateTime       @default(now()) @map("joined_at") @db.Date
  leftAt     DateTime?      @map("left_at") @db.Date
  isActive   Boolean        @default(true) @map("is_active")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([teamId, employeeId, isActive])
  @@index([employeeId, isActive])
  @@map("team_members")
}

model AttendanceRecord {
  id               Int                  @id @default(autoincrement())
  employeeId       Int                  @map("employee_id")
  workDate         DateTime             @map("work_date") @db.Date
  recordType       AttendanceRecordType @map("record_type")
  recordedAt       DateTime             @map("recorded_at")
  shift            AttendanceShift?
  attendanceStatus AttendanceStatus?    @map("attendance_status")
  latitude         Float?
  longitude        Float?
  address          String?              @db.VarChar(255)
  distanceMeters   Int?                 @map("distance_meters")
  source           String               @default("MOBILE") @db.VarChar(40)
  note             String?              @db.VarChar(500)
  isAdjustment     Boolean              @default(false) @map("is_adjustment")
  createdByUserId  Int?                 @map("created_by_user_id")
  updatedByUserId  Int?                 @map("updated_by_user_id")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  employee      Employee @relation(fields: [employeeId], references: [id])
  createdByUser User?    @relation("AttendanceCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUser User?    @relation("AttendanceUpdatedBy", fields: [updatedByUserId], references: [id])

  @@index([employeeId, workDate])
  @@map("attendance_records")
}

model SystemSetting {
  key       String   @id @db.VarChar(120)
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model LeaveType {
  id              Int      @id @default(autoincrement())
  code            String   @unique @db.VarChar(80)
  name            String   @db.VarChar(160)
  annualAllowance Int?     @map("annual_allowance")
  isPaid          Boolean  @default(true) @map("is_paid")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  leaveRequests LeaveRequest[]

  @@map("leave_types")
}

model LeaveRequest {
  id              Int                @id @default(autoincrement())
  employeeId      Int                @map("employee_id")
  leaveTypeId     Int                @map("leave_type_id")
  startDate       DateTime           @map("start_date") @db.Date
  endDate         DateTime           @map("end_date") @db.Date
  totalDays       Int                @map("total_days")
  reason          String             @db.VarChar(1000)
  status          LeaveRequestStatus @default(PENDING)
  approverUserId  Int?               @map("approver_user_id")
  approvedAt      DateTime?          @map("approved_at")
  rejectionReason String?            @map("rejection_reason") @db.VarChar(1000)
  canceledAt      DateTime?          @map("canceled_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  approver  User?     @relation("LeaveApprover", fields: [approverUserId], references: [id])

  @@index([employeeId, startDate, endDate])
  @@map("leave_requests")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.VarChar(80)
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address") @db.VarChar(80)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, action, createdAt])
  @@map("audit_logs")
}

enum NotificationType {
  LEAVE_APPROVED
  LEAVE_REJECTED
  TASK_ASSIGNED
  TASK_STATUS_CHANGED
  ATTENDANCE_ADJUSTED
  REVIEW_FINALIZED
}

model Notification {
  id         Int              @id @default(autoincrement())
  userId     Int              @map("user_id")
  type       NotificationType
  title      String           @db.VarChar(200)
  message    String           @db.VarChar(1000)
  entityType String?          @map("entity_type") @db.VarChar(80)
  entityId   Int?             @map("entity_id")
  isRead     Boolean          @default(false) @map("is_read")
  createdAt  DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

enum ReviewCycleStatus {
  OPEN
  CLOSED
}

enum PerformanceReviewStatus {
  PENDING_SELF
  SELF_SUBMITTED
  MANAGER_REVIEWED
  FINALIZED
}

model ReviewCycle {
  id        Int               @id @default(autoincrement())
  name      String            @db.VarChar(160)
  startDate DateTime          @map("start_date") @db.Date
  endDate   DateTime          @map("end_date") @db.Date
  status    ReviewCycleStatus @default(OPEN)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  reviews PerformanceReview[]

  @@map("review_cycles")
}

model PerformanceReview {
  id             Int                     @id @default(autoincrement())
  cycleId        Int                     @map("cycle_id")
  employeeId     Int                     @map("employee_id")
  reviewerUserId Int?                    @map("reviewer_user_id")
  selfRating     Int?                    @map("self_rating")
  selfComment    String?                 @map("self_comment") @db.Text
  managerRating  Int?                    @map("manager_rating")
  managerComment String?                 @map("manager_comment") @db.Text
  finalRating    Int?                    @map("final_rating")
  status         PerformanceReviewStatus @default(PENDING_SELF)
  submittedAt    DateTime?               @map("submitted_at")
  reviewedAt     DateTime?               @map("reviewed_at")
  finalizedAt    DateTime?               @map("finalized_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  cycle    ReviewCycle @relation(fields: [cycleId], references: [id])
  employee Employee    @relation(fields: [employeeId], references: [id])
  reviewer User?       @relation("PerformanceReviewReviewer", fields: [reviewerUserId], references: [id])

  @@unique([cycleId, employeeId])
  @@map("performance_reviews")
}

model ChatbotConversation {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  title     String?   @db.VarChar(160)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user     User                   @relation(fields: [userId], references: [id])
  messages ChatbotMessage[]
  actions  ChatbotPendingAction[]

  @@index([userId])
  @@map("chatbot_conversations")
}

model ChatbotMessage {
  id             Int                @id @default(autoincrement())
  conversationId Int                @map("conversation_id")
  role           ChatbotMessageRole
  content        String             @db.Text
  metadata       Json?
  createdAt      DateTime           @default(now()) @map("created_at")

  conversation ChatbotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("chatbot_messages")
}

model ChatbotPendingAction {
  id             Int                 @id @default(autoincrement())
  conversationId Int                 @map("conversation_id")
  userId         Int                 @map("user_id")
  actionType     ChatbotActionType   @map("action_type")
  status         ChatbotActionStatus @default(PENDING)
  payload        Json
  result         Json?
  expiresAt      DateTime            @map("expires_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  confirmedAt    DateTime?           @map("confirmed_at")
  cancelledAt    DateTime?           @map("cancelled_at")

  conversation ChatbotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([conversationId])
  @@map("chatbot_pending_actions")
}

model Project {
  id              Int           @id @default(autoincrement())
  departmentId    Int           @map("department_id")
  managerId       Int           @map("manager_id")
  code            String        @unique @db.VarChar(50)
  name            String        @db.VarChar(255)
  description     String?       @db.Text
  status          ProjectStatus @default(ACTIVE)
  startDate       DateTime?     @map("start_date") @db.Date
  endDate         DateTime?     @map("end_date") @db.Date
  createdByUserId Int?          @map("created_by")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  department    Department @relation(fields: [departmentId], references: [id])
  manager       Employee   @relation("ProjectManager", fields: [managerId], references: [id])
  createdByUser User?      @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id])
  tasks         Task[]

  @@index([departmentId, managerId, status])
  @@map("projects")
}

model Skill {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  category    String?  @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employeeSkills     EmployeeSkill[]
  taskRequiredSkills TaskRequiredSkill[]
  positionSkills     PositionSkill[]

  @@map("skills")
}

model PositionSkill {
  positionId Int      @map("position_id")
  skillId    Int      @map("skill_id")
  createdAt  DateTime @default(now()) @map("created_at")

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([positionId, skillId])
  @@map("position_skills")
}

model EmployeeSkill {
  id              Int              @id @default(autoincrement())
  employeeId      Int              @map("employee_id")
  skillId         Int              @map("skill_id")
  yearsExperience Decimal?         @map("years_experience") @db.Decimal(4, 1)
  proficiency     SkillProficiency
  lastUsedAt      DateTime?        @map("last_used_at") @db.Date
  note            String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])
  skill    Skill    @relation(fields: [skillId], references: [id])

  @@unique([employeeId, skillId])
  @@map("employee_skills")
}

model Task {
  id               Int          @id @default(autoincrement())
  parentTaskId     Int?         @map("parent_task_id")
  projectId        Int?         @map("project_id")
  departmentId     Int?         @map("department_id")
  teamId           Int?         @map("team_id")
  title            String       @db.VarChar(255)
  description      String?      @db.Text
  technologies     String[]     @default([])
  priority         TaskPriority @default(MEDIUM)
  status           TaskStatus   @default(TODO)
  assigneeId       Int?         @map("assignee_id")
  createdByUserId  Int?         @map("created_by")
  assignedByUserId Int?         @map("assigned_by")
  startDate        DateTime?    @map("start_date") @db.Date
  dueDate          DateTime?    @map("due_date") @db.Date
  estimatedHours   Decimal?     @map("estimated_hours") @db.Decimal(6, 2)
  actualHours      Decimal?     @map("actual_hours") @db.Decimal(6, 2)
  completedAt      DateTime?    @map("completed_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deletedAt        DateTime?    @map("deleted_at")

  parentTask        Task?               @relation("TaskHierarchy", fields: [parentTaskId], references: [id])
  childTasks        Task[]              @relation("TaskHierarchy")
  project           Project?            @relation(fields: [projectId], references: [id])
  department        Department?         @relation(fields: [departmentId], references: [id])
  team              Team?               @relation(fields: [teamId], references: [id])
  assignee          Employee?           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdByUser     User?               @relation("TaskCreatedBy", fields: [createdByUserId], references: [id])
  assignedByUser    User?               @relation("TaskAssignedBy", fields: [assignedByUserId], references: [id])
  requiredSkills    TaskRequiredSkill[]
  assignments       TaskAssignment[]
  aiTaskSuggestions AiTaskSuggestion[]

  @@index([projectId, departmentId, teamId, assigneeId, status, priority])
  @@index([parentTaskId, status])
  @@index([dueDate])
  @@map("tasks")
}

model TaskRequiredSkill {
  id                  Int                 @id @default(autoincrement())
  taskId              Int                 @map("task_id")
  skillId             Int                 @map("skill_id")
  requiredProficiency SkillProficiency    @map("required_proficiency")
  importance          TaskSkillImportance @default(IMPORTANT)
  createdAt           DateTime            @default(now()) @map("created_at")

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id])

  @@unique([taskId, skillId])
  @@map("task_required_skills")
}

model TaskAssignment {
  id               Int                @id @default(autoincrement())
  taskId           Int                @map("task_id")
  assigneeId       Int                @map("assignee_id")
  assignedByUserId Int                @map("assigned_by")
  assignmentType   TaskAssignmentType @map("assignment_type")
  note             String?            @db.Text
  assignedAt       DateTime           @default(now()) @map("assigned_at")

  task           Task     @relation(fields: [taskId], references: [id])
  assignee       Employee @relation("TaskAssignmentAssignee", fields: [assigneeId], references: [id])
  assignedByUser User     @relation("TaskAssignmentAssignedBy", fields: [assignedByUserId], references: [id])

  @@index([taskId, assigneeId, assignedAt])
  @@map("task_assignments")
}

model AiTaskSuggestion {
  id                Int                    @id @default(autoincrement())
  taskId            Int                    @map("task_id")
  requestedByUserId Int                    @map("requested_by")
  algorithmVersion  String                 @default("rule-based-v1") @map("algorithm_version") @db.VarChar(50)
  inputSnapshot     Json?                  @map("input_snapshot")
  status            AiTaskSuggestionStatus @default(GENERATED)
  createdAt         DateTime               @default(now()) @map("created_at")

  task            Task                   @relation(fields: [taskId], references: [id])
  requestedByUser User                   @relation("AiTaskSuggestionRequestedBy", fields: [requestedByUserId], references: [id])
  items           AiTaskSuggestionItem[]

  @@index([taskId, requestedByUserId, status])
  @@map("ai_task_suggestions")
}

model AiTaskSuggestionItem {
  id                Int      @id @default(autoincrement())
  suggestionId      Int      @map("suggestion_id")
  employeeId        Int      @map("employee_id")
  rank              Int
  score             Decimal  @db.Decimal(5, 2)
  skillScore        Decimal? @map("skill_score") @db.Decimal(5, 2)
  workloadScore     Decimal? @map("workload_score") @db.Decimal(5, 2)
  availabilityScore Decimal? @map("availability_score") @db.Decimal(5, 2)
  performanceScore  Decimal? @map("performance_score") @db.Decimal(5, 2)
  reason            String?  @db.Text
  selected          Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at")

  suggestion AiTaskSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  employee   Employee         @relation(fields: [employeeId], references: [id])

  @@unique([suggestionId, employeeId])
  @@map("ai_task_suggestion_items")
}

model EmployeeCompensation {
  id              Int      @id @default(autoincrement())
  employeeId      Int      @unique @map("employee_id")
  baseSalary      Int      @map("base_salary")
  allowance       Int      @default(0)
  // Salary used for mandatory insurance; falls back to baseSalary when null.
  insuranceSalary Int?     @map("insurance_salary")
  updatedByUserId Int?     @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_compensations")
}

model PayrollPeriod {
  id                Int                 @id @default(autoincrement())
  year              Int
  month             Int
  status            PayrollPeriodStatus @default(DRAFT)
  calculatedAt      DateTime?           @map("calculated_at")
  finalizedAt       DateTime?           @map("finalized_at")
  finalizedByUserId Int?                @map("finalized_by_user_id")
  createdByUserId   Int?                @map("created_by_user_id")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  payslips Payslip[]

  @@unique([year, month])
  @@map("payroll_periods")
}

/// A payslip snapshots every input it was computed from, so a finalized period
/// keeps its numbers even if salaries or attendance change later.
model Payslip {
  id                  Int       @id @default(autoincrement())
  periodId            Int       @map("period_id")
  employeeId          Int       @map("employee_id")
  baseSalary          Int       @map("base_salary")
  allowance           Int
  insuranceSalary     Int       @map("insurance_salary")
  standardWorkDays    Float     @map("standard_work_days")
  attendanceDays      Float     @map("attendance_days")
  paidLeaveDays       Float     @map("paid_leave_days")
  payableDays         Float     @map("payable_days")
  lateMinutes         Int       @map("late_minutes")
  earlyLeaveMinutes   Int       @map("early_leave_minutes")
  overtimeMinutes     Int       @map("overtime_minutes")
  missingCheckOuts    Int       @map("missing_check_outs")
  grossSalary         Int       @map("gross_salary")
  overtimePay         Int       @map("overtime_pay")
  attendanceDeduction Int       @map("attendance_deduction")
  insuranceDeduction  Int       @map("insurance_deduction")
  netSalary           Int       @map("net_salary")
  emailedAt           DateTime? @map("emailed_at")
  emailError          String?   @map("email_error") @db.VarChar(500)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  period   PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id])

  @@unique([periodId, employeeId])
  @@map("payslips")
}
