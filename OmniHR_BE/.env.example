NODE_ENV=development
PORT=3000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345678
POSTGRES_DB=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:12345678@localhost:5432/postgres?schema=public"

# Optional. Unset, throttler and chatbot rate limits count per instance.
# Compose overrides the host to the `redis` service.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
DOCKER_REDIS_HOST=redis

JWT_ACCESS_SECRET=replace-with-a-strong-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-strong-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

DEFAULT_ADMIN_USERNAME=superadmin
DEFAULT_ADMIN_EMAIL=admin@corehr.local
DEFAULT_ADMIN_PASSWORD=Admin@123456

CORS_ORIGIN=http://localhost:5174

AI_SERVICE_URL=http://localhost:8000
DOCKER_AI_SERVICE_URL=http://omnihr-ai:8000
AI_INTERNAL_TOKEN=replace-with-a-strong-internal-token-at-least-32-chars
AI_TIMEOUT_MS=30000
CHATBOT_RATE_LIMIT_TTL_SECONDS=60
CHATBOT_RATE_LIMIT_MAX=20
CHATBOT_RATE_LIMIT_PER_MINUTE=20
CHATBOT_HISTORY_LIMIT=12
CHATBOT_MAX_MESSAGE_LENGTH=1000
CHATBOT_PENDING_ACTION_TTL_MINUTES=30

# The AI service rewrites each assignee suggestion reason in natural language.
# Set to false to keep the template sentences (no LLM call per suggestion).
AI_SUGGESTION_EXPLANATIONS=true
# Daily clean-up of audit rows past the retention set in system settings
AUDIT_RETENTION_JOB=true
AI_SUGGESTION_EXPLAIN_TIMEOUT_MS=8000

# Push notifications to the mobile app (Firebase Cloud Messaging). Paste the
# service-account key from Firebase console > Project settings > Service
# accounts, base64-encoded onto one line. Empty = no push, everything else works.
FIREBASE_SERVICE_ACCOUNT_JSON=

AI_PLANNER_MODE=hybrid
LLM_PROVIDER=openai_compatible
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=your-gemini-api-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
# All LLM attempts together; keep below the backend's AI_TIMEOUT_MS so the rule-based fallback can still answer
LLM_TOTAL_BUDGET_SECONDS=20
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=800
LLM_FALLBACK_TO_RULE_BASED=true
LLM_CONFIDENCE_THRESHOLD=0.6

# Passed through to the omnihr-ai container by docker compose.
# Blank embedding base URL / key falls back to the LLM ones.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=none
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# The two thresholds depend on the embedding model. For Gemini
# (EMBEDDING_PROVIDER=openai_compatible, EMBEDDING_MODEL=gemini-embedding-001) use
# RAG_MIN_EMBEDDING_SCORE=0.73 and RAG_MIN_EMBEDDING_GAP=0.04, chosen on the dev half of
# OmniHR_AI/app/eval/rag_cases.json by scripts/evaluate_rag.py --tune
# (eval_results/rag-gemini-embedding-001.md). Keyword-only finds far fewer policies.
# keyword | embedding | hybrid (hybrid degrades to keyword with no provider)
RAG_MODE=hybrid
RAG_EMBEDDING_WEIGHT=0.6
RAG_MIN_EMBEDDING_SCORE=0.55
RAG_MIN_EMBEDDING_GAP=0.10

# Outgoing email for the one-time codes asked before a password, phone or email
# change. With Gmail: SMTP_USER is the address, SMTP_PASS an App Password for it
# (Google account > Security > 2-Step Verification > App passwords) - never the
# account password. Left empty in development, codes are written to the API log.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=OmniHR <your-address@gmail.com>
