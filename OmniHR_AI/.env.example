AI_INTERNAL_TOKEN=replace-with-a-strong-internal-token-at-least-32-chars
AI_PLANNER_MODE=rule_based
LLM_PROVIDER=mock
LLM_MODEL=rule-based-vi-v1
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=800
LLM_FALLBACK_TO_RULE_BASED=true
LLM_CONFIDENCE_THRESHOLD=0.6
# Set EMBEDDING_PROVIDER=openai_compatible plus a model to enable semantic
# retrieval. Left as mock, RAG runs keyword-only and needs no network.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=none
# Default to the LLM base URL / key when blank.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# keyword | embedding | hybrid (hybrid degrades to keyword with no provider)
RAG_MODE=hybrid
RAG_EMBEDDING_WEIGHT=0.6
RAG_MIN_EMBEDDING_SCORE=0.55
RAG_MIN_EMBEDDING_GAP=0.10
